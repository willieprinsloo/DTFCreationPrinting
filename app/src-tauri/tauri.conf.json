{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DTF Print Studio",
  "version": "0.1.0",
  "identifier": "za.co.dtfcreations.printstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DTF Print Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost thumb: http://thumb.localhost https://dtfcreations.co.za http://localhost:8000 data: blob:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/assets/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pdfium/bundle/*": "pdfium/",
      "realesrgan/bundle/*": "realesrgan/",
      "realesrgan/bundle/models/*": "realesrgan/models/",
      "colour-profiles/bundle/*": "colour-profiles/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
